while len(user_input) < 10:
    print("Your password is weak. Please try again.")
    user_input = input("Please set your password: ")

print("Done! Your password is strong.")

while True:
    remember_password = input(
        "Do you remember your password? (yes/no): "
    ).lower()

    if remember_password == "yes":
        print("Now please enter your password to confirm:")
        confirm_password = input()

        if confirm_password == user_input:
            print("Password confirmed. You are logged in.")
            break
        else:
            print("Password does not match. Please try again.")

    elif remember_password == "no":
        print("Please set your password again:")

        user_input = input("Please set your password: ")

        while len(user_input) < 10:
            print("Your password is weak. Please try again.")
            user_input = input("Please set your password: ")

        print("Done! Your password is strong.")

    else:
        print("Please answer yes or no.")
